---
// Interactive dial-format tool for a single country's international-dialing
// guide page. Pure static Astro + a vanilla <script type="module"> island --
// no framework dependency. The DialingGuide for this page is injected as a
// prop and serialized into a data-* attribute so the client script (which
// runs in the browser, with no access to Astro.props) can read it.
import type { DialingGuide } from '../lib/internationalDialing';

interface Props {
	guide: DialingGuide;
}

const { guide } = Astro.props;
const guideJson = JSON.stringify(guide);
---

<div class="dial-format-builder rounded-lg border border-[var(--rule)] bg-[var(--paper)] p-5" data-guide={guideJson}>
	<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-[var(--ink)]/45">Try it yourself</p>
	<h2 class="mt-1.5 mb-0 text-lg font-bold text-[var(--ink)]">Format your own {guide.country} number</h2>
	<p class="mt-2 mb-0 text-sm leading-relaxed text-[var(--ink)]/65">
		Enter a local number the way it's written in {guide.country} and this tool will apply {guide.country}'s
		specific dialing rule to produce the exact number to dial from the US.
	</p>

	<div class="mt-4 flex flex-col gap-2 sm:flex-row">
		<label for="dial-input" class="sr-only">Local number in {guide.country}</label>
		<input
			id="dial-input"
			type="text"
			inputmode="tel"
			autocomplete="off"
			placeholder={`e.g. ${guide.example.replace(/^\S+\s+\S+\s+/, '')}`}
			class="min-w-0 flex-1 rounded-md border border-[var(--rule)] bg-white px-3 py-2 text-[0.9375rem] text-[var(--ink)] outline-none focus:border-[var(--accent)]"
		/>
		<button
			id="dial-format-btn"
			type="button"
			class="shrink-0 rounded-md bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-white hover:bg-[var(--accent-dark)]"
		>
			Format for dialing
		</button>
	</div>

	<p id="dial-warning" class="mt-3 mb-0 hidden text-sm font-medium text-[#a3402f]" role="alert"></p>

	<div id="dial-result" class="mt-4 hidden" aria-live="polite">
		<div class="flex flex-col gap-2 sm:flex-row sm:gap-3">
			<div class="flex-1 rounded-md border border-[var(--rule)] bg-white px-3 py-2.5">
				<p class="m-0 text-[0.65rem] font-semibold uppercase tracking-[0.08em] text-[var(--ink)]/45">Dial (exit code)</p>
				<p id="dial-result-exit" class="font-mono-num mt-1 mb-0 text-base font-bold text-[var(--ink)]"></p>
			</div>
			<div id="dial-result-plus-wrap" class="flex-1 rounded-md border border-[var(--rule)] bg-white px-3 py-2.5">
				<p class="m-0 text-[0.65rem] font-semibold uppercase tracking-[0.08em] text-[var(--ink)]/45">Dial (mobile/VoIP "+")</p>
				<p id="dial-result-plus" class="font-mono-num mt-1 mb-0 text-base font-bold text-[var(--ink)]"></p>
			</div>
		</div>
		<p class="mt-3 mb-0 text-sm leading-relaxed text-[var(--ink)]/60">
			<strong class="text-[var(--ink)]/80">Why it's formatted this way:</strong> {guide.quirk}
		</p>
	</div>
</div>

<script>
	import { formatForDialing } from '../lib/dialFormatter';

	// Scope to this specific instance in case more than one ever ends up on a page.
	document.querySelectorAll('.dial-format-builder').forEach((root) => {
		const guideJson = root.getAttribute('data-guide');
		if (!guideJson) return;
		const guide = JSON.parse(guideJson);

		const input = root.querySelector('#dial-input');
		const button = root.querySelector('#dial-format-btn');
		const warningEl = root.querySelector('#dial-warning');
		const resultEl = root.querySelector('#dial-result');
		const exitEl = root.querySelector('#dial-result-exit');
		const plusEl = root.querySelector('#dial-result-plus');
		const plusWrap = root.querySelector('#dial-result-plus-wrap');

		if (!input || !button || !warningEl || !resultEl || !exitEl || !plusEl) return;

		function run() {
			const value = input.value;
			const result = formatForDialing(value, guide);

			if (result.warning) {
				warningEl.textContent = result.warning;
				warningEl.classList.remove('hidden');
				resultEl.classList.add('hidden');
				return;
			}

			warningEl.classList.add('hidden');
			warningEl.textContent = '';

			exitEl.textContent = result.exitCodeFormat;
			if (result.plusFormat) {
				plusEl.textContent = result.plusFormat;
				if (plusWrap) plusWrap.classList.remove('hidden');
			} else if (plusWrap) {
				plusWrap.classList.add('hidden');
			}
			resultEl.classList.remove('hidden');
		}

		button.addEventListener('click', run);
		input.addEventListener('keydown', (e) => {
			if (e.key === 'Enter') {
				e.preventDefault();
				run();
			}
		});
	});
</script>
