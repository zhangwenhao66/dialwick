---
import Layout from '../../layouts/Layout.astro';
import { guides } from '../../data/guides';
import { getDialingGuide } from '../../lib/internationalDialing';

const categoryGuides = guides.filter((g) => g.category === 'International Dialing');

// Directory-entry code: the country calling code from the dialing data,
// otherwise a padded row number.
const entryCode = (slug: string, i: number) => {
	const dg = getDialingGuide(slug);
	return dg?.countryCode ? `+${dg.countryCode}` : String(i + 1).padStart(2, '0');
};
---

<Layout
	title="International Dialing"
	description="How to dial another country from the US -- exit codes, country codes, and the leading-zero rules that trip up most guides."
>
	<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-[var(--accent-dark)]">Section</p>
	<h1 class="mt-2 text-3xl font-bold text-[var(--ink)] md:text-4xl">International Dialing</h1>
	<p class="mt-3 max-w-2xl text-lg text-[var(--ink)]/60">
		Country-by-country dialing formats from the US, kept current -- including the reforms and
		exceptions (Mexico's 2019 mobile-dialing change, Italy's leading zero) that older guides miss.
	</p>

	{categoryGuides.length === 0 ? (
		<p class="mt-10 text-sm text-[var(--ink)]/70">Pages in this section are coming soon.</p>
	) : (
		<div class="mt-10">
			<p class="idx-tab font-mono-num m-0 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-[var(--accent-dark)]">Index</p>
			<div class="idx-card flex flex-col">
				{categoryGuides.map((g, i) => (
					<a href={`/${g.slug}/`} class="group block border-b border-dotted border-[var(--rule)] px-5 py-4 no-underline last:border-b-0">
						<span class="dir-row">
							<span class="font-mono-num shrink-0 text-[0.82rem] font-bold text-[var(--accent-dark)]">{entryCode(g.slug, i)}</span>
							<span class="min-w-0 text-base font-bold leading-snug text-[var(--ink)] group-hover:underline">{g.title}</span>
							<span class="dir-leader" aria-hidden="true"></span>
							<span class="dir-arrow font-mono-num shrink-0 text-sm text-[var(--accent-dark)]" aria-hidden="true">&rarr;</span>
						</span>
						<span class="mt-1 block text-sm leading-relaxed text-[var(--ink)]/70">{g.description}</span>
					</a>
				))}
			</div>
		</div>
	)}
</Layout>
