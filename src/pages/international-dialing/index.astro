---
import Layout from '../../layouts/Layout.astro';
import { guides } from '../../data/guides';

const categoryGuides = guides.filter((g) => g.category === 'International Dialing');
---

<Layout
	title="International Dialing"
	description="How to dial another country from the US -- exit codes, country codes, and the leading-zero rules that trip up most guides."
>
	<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-[var(--accent-dark)]">Section</p>
	<h1 class="mt-2 text-3xl font-bold text-[var(--ink)] md:text-4xl">International Dialing</h1>
	<p class="mt-3 max-w-2xl text-lg text-[var(--ink)]/60">
		Country-by-country dialing formats from the US, kept current -- including the reforms and
		exceptions (Mexico's 2019 mobile-dialing change, Italy's leading zero) that older guides miss.
	</p>

	{categoryGuides.length === 0 ? (
		<p class="mt-10 text-sm text-[var(--ink)]/40">Pages in this section are coming soon.</p>
	) : (
		<div class="mt-10 flex flex-col">
			{categoryGuides.map((g) => (
				<a href={`/${g.slug}/`} class="item border-b border-[var(--rule)] py-5 no-underline first:pt-0">
					<p class="m-0 text-lg font-bold leading-snug text-[var(--ink)] hover:underline">{g.title}</p>
					<p class="m-0 mt-1.5 text-sm text-[var(--ink)]/55">{g.description}</p>
				</a>
			))}
		</div>
	)}
</Layout>

<style>
	.item { display: block; transition: padding-left 0.15s ease; }
	.item:hover { padding-left: 0.5rem; }
</style>
