---
import Layout from '../../layouts/Layout.astro';
import { guides } from '../../data/guides';

const categoryGuides = guides.filter((g) => g.category === 'ZIP Codes');
---

<Layout
	title="ZIP Codes"
	description="US ZIP code lookups by city -- the full list, which county each one falls into, and the quirks a simple list won't show you."
>
	<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-[var(--accent-dark)]">Section</p>
	<h1 class="mt-2 text-3xl font-bold text-[var(--ink)] md:text-4xl">ZIP Codes</h1>
	<p class="mt-3 max-w-2xl text-lg text-[var(--ink)]/60">
		City ZIP code lookups, sourced from USPS/Census-derived postal data -- full lists, county
		breakdowns, and the edge cases (unique-purpose ZIPs, cross-county splits) most lists skip.
	</p>

	{categoryGuides.length === 0 ? (
		<p class="mt-10 text-sm text-[var(--ink)]/70">Pages in this section are coming soon.</p>
	) : (
		<div class="mt-10">
			<p class="idx-tab font-mono-num m-0 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-[var(--accent-dark)]">Index</p>
			<div class="idx-card flex flex-col">
				{categoryGuides.map((g, i) => (
					<a href={`/${g.slug}/`} class="group block border-b border-dotted border-[var(--rule)] px-5 py-4 no-underline last:border-b-0">
						<span class="dir-row">
							<span class="font-mono-num shrink-0 text-[0.82rem] font-bold text-[var(--accent-dark)]">{String(i + 1).padStart(2, '0')}</span>
							<span class="min-w-0 text-base font-bold leading-snug text-[var(--ink)] group-hover:underline">{g.title}</span>
							<span class="dir-leader" aria-hidden="true"></span>
							<span class="dir-arrow font-mono-num shrink-0 text-sm text-[var(--accent-dark)]" aria-hidden="true">&rarr;</span>
						</span>
						<span class="mt-1 block text-sm leading-relaxed text-[var(--ink)]/70">{g.description}</span>
					</a>
				))}
			</div>
		</div>
	)}
</Layout>
