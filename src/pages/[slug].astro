---
import Layout from '../layouts/Layout.astro';
import Article from '../../vendor/site-toolkit/packages/schema/src/Article.astro';
import BreadcrumbList from '../../vendor/site-toolkit/packages/schema/src/BreadcrumbList.astro';
import FAQPage from '../../vendor/site-toolkit/packages/schema/src/FAQPage.astro';
import { pickRelatedGuides } from '../../vendor/site-toolkit/packages/related-guides/src/index.ts';
import { guides, type Guide, type GuideCategory } from '../data/guides';
import { getDialingGuide } from '../lib/internationalDialing';
import DialFormatBuilder from '../components/DialFormatBuilder.astro';
import FeedbackSlip from '../components/FeedbackSlip.astro';
import { AUTHOR_NAME, SITE_ORIGIN } from '../consts';

export function getStaticPaths() {
	return guides.map((guide) => ({
		params: { slug: guide.slug },
		props: { guide },
	}));
}

interface Props {
	guide: Guide;
}

const { guide } = Astro.props;
// Rotating-window related-guides selection -- see vendor/site-toolkit/packages/related-guides
// for why this isn't a fixed .slice(0, 6) (that bug starved most of a category of any inbound link).
const related = pickRelatedGuides(guides, guide);

const categoryToPath: Record<GuideCategory, string> = {
	'ZIP Codes': '/zip-codes/',
	'Area Code Lists': '/area-codes/',
	'Area Code Guides': '/area-codes/',
	'Area Codes': '/area-codes/',
	Counties: '/counties/',
	'International Dialing': '/international-dialing/',
};
const catPath = categoryToPath[guide.category] ?? '/';

// International-dialing pages get an interactive dial-format tool, driven
// by the same per-country data (exitCode/countryCode/quirk) already used
// to write the article -- see src/lib/dialFormatter.ts.
const dialingGuide = guide.category === 'International Dialing' ? getDialingGuide(guide.slug) : undefined;

const pageUrl = `${SITE_ORIGIN}/${guide.slug}/`;
const heroImage = `${SITE_ORIGIN}/favicon.svg`;
const toISO = (d: string) => `${d}T00:00:00+00:00`;
const breadcrumbItems = [
	{ name: 'Home', item: `${SITE_ORIGIN}/` },
	{ name: guide.category, item: `${SITE_ORIGIN}${catPath}` },
	{ name: guide.title, item: pageUrl },
];

function md(text: string): string {
	return text
		.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
		.replace(/\*(.*?)\*/g, '<em>$1</em>')
		.replace(/\[([^\]]+)\]\(((?:[^()]|\([^()]*\))*)\)/g, '<a href="$2">$1</a>');
}
import { imgDims } from '../data/imageDims';
---

<Layout title={guide.title} description={guide.description} ogImage="/favicon.svg" ogType="article">
	{guide.faq && guide.faq.length > 0 && <FAQPage items={guide.faq} slot="head" />}
	<Article
		slot="head"
		headline={guide.title}
		description={guide.description}
		datePublished={toISO(guide.published ?? guide.updated)}
		dateModified={toISO(guide.updated)}
		authorName={AUTHOR_NAME}
		authorUrl={`${SITE_ORIGIN}/about/`}
		image={heroImage}
		imageWidth={imgDims(heroImage)?.w}
		imageHeight={imgDims(heroImage)?.h}
		url={pageUrl}
	/>
	<BreadcrumbList slot="head" items={breadcrumbItems} />

	<div class="rule -mt-10 bg-[var(--directory)]">
		<div class="rule-inner py-10 md:py-12">
			<div class="mx-auto max-w-[760px]">
				<nav class="mb-6 flex flex-wrap items-center gap-1.5 text-sm text-[var(--directory-text)]/55">
					<a href="/" class="no-underline hover:text-white hover:underline">Home</a>
					<span>/</span>
					<a href={catPath} class="no-underline hover:text-white hover:underline">{guide.category}</a>
				</nav>
				<p class="m-0 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-[var(--accent)]">{guide.category}</p>
				<h1 class="mt-3 text-3xl leading-[1.15] font-bold text-white md:text-4xl">{guide.title}</h1>
				<p class="mt-4 text-lg leading-relaxed text-[var(--directory-text)]/90">{guide.description}</p>
				<p class="mt-4 mb-0 text-xs text-[var(--directory-text)]/50">Last updated {guide.updated}</p>
			</div>
		</div>
	</div>

	<div class="mx-auto max-w-[760px]">
		<div class="mt-9">
			<p class="idx-tab font-mono-num m-0 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-[var(--accent-dark)]">Core summary</p>
			<div class="idx-card px-5 py-4">
				<p class="m-0 text-[1.05rem] leading-relaxed text-[var(--ink)]">{guide.coreSummary}</p>
			</div>
		</div>

		{dialingGuide && (
			<div class="mt-9">
				<DialFormatBuilder guide={dialingGuide} />
			</div>
		)}

		<div class="adsterra-slots">
			<script
				async="async"
				data-cfasync="false"
				src="https://pl31132728.profitableratecpmnetwork.com/e8ff8777c6eca485b0750803d487cc5b/invoke.js"></script>
			<div id="container-e8ff8777c6eca485b0750803d487cc5b"></div>

			<script is:inline>
				atOptions = {
					'key': '089560fe6a901144801c736470dc3676',
					'format': 'iframe',
					'height': 250,
					'width': 300,
					'params': {},
				};
			</script>
			<script is:inline src="https://www.highrevenueformat.com/089560fe6a901144801c736470dc3676/invoke.js"></script>

			<div class="adsterra-leaderboard">
				<script is:inline>
					atOptions = {
						'key': '11d96407f2ea0f9c39a67f38b6f92db3',
						'format': 'iframe',
						'height': 90,
						'width': 728,
						'params': {},
					};
				</script>
				<script is:inline src="https://www.highrevenueformat.com/11d96407f2ea0f9c39a67f38b6f92db3/invoke.js"></script>
			</div>
		</div>

		<article class="mt-9">
			{guide.sections.map((section) => (
				<section class="mb-8 border-b border-dotted border-[var(--rule)] pb-8 last:mb-0 last:border-b-0 last:pb-0">
					<h2 class="mb-3.5 text-xl font-bold text-[var(--ink)]">{section.heading}</h2>
					{section.body.map((paragraph) => <p class="mb-3.5 text-[0.9375rem] leading-[1.85] text-[var(--ink)]/70 last:mb-0" set:html={md(paragraph)} />)}
					{section.diagramSvg && (
						<div class="my-5 overflow-x-auto rounded-lg border border-[var(--rule)] bg-white p-4" set:html={section.diagramSvg} />
					)}
					{section.table && (
						<div class="my-5 overflow-x-auto rounded-lg border-[1.5px] border-[var(--ink)]/75">
							{section.table.caption && (
								<p class="font-mono-num m-0 border-b border-dotted border-[var(--rule)] bg-[var(--paper)] px-4 py-2 text-xs font-semibold text-[var(--ink)]/70">{section.table.caption}</p>
							)}
							<table class="w-full border-collapse text-left text-sm">
								<thead>
									<tr class="bg-[var(--paper)]">
										{section.table.columns.map((col) => (
											<th class="font-mono-num border-b border-[var(--ink)]/40 px-4 py-2 text-[0.78rem] font-semibold tracking-wide text-[var(--ink)]/70">{col}</th>
										))}
									</tr>
								</thead>
								<tbody>
									{section.table.rows.map((row) => (
										<tr class="border-b border-dotted border-[var(--rule)] last:border-b-0">
											{row.map((cell, i) => (
												<td class={`px-4 py-1.5 text-[var(--ink)]/80 ${i === 0 ? 'font-mono-num font-semibold text-[var(--accent-dark)]' : ''}`}>{cell}</td>
											))}
										</tr>
									))}
								</tbody>
							</table>
						</div>
					)}
				</section>
			))}
		</article>

		{guide.faq && guide.faq.length > 0 && (
			<div class="mt-9">
				<h2 class="mb-4 text-xl font-bold text-[var(--ink)]">Frequently asked questions</h2>
				<div class="flex flex-col">
					{guide.faq.map((item) => (
						<div class="border-b border-dotted border-[var(--rule)] py-4 first:pt-0 last:border-b-0">
							<p class="m-0 font-semibold text-[var(--ink)]">{item.question}</p>
							<p class="mt-2 mb-0 text-sm leading-relaxed text-[var(--ink)]/65" set:html={md(item.answer)} />
						</div>
					))}
				</div>
			</div>
		)}

		{guide.sources && guide.sources.length > 0 && (
			<div class="mt-9 border-t-2 border-dotted border-[var(--ink)]/60 pt-4">
				<p class="font-mono-num m-0 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-[var(--ink)]/70">Sources</p>
				<ul class="mt-2 mb-0 list-none pl-0 text-sm text-[var(--ink)]/65">
					{guide.sources.map((s) => (
						<li class="py-1"><a href={s.url} target="_blank" rel="noopener noreferrer" class="text-[var(--ink)]/70 no-underline hover:text-[var(--ink)] hover:underline">{s.label}</a></li>
					))}
				</ul>
			</div>
		)}

		{related.length > 0 && (
			<div class="mt-10">
				<h3 class="idx-tab font-mono-num m-0 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-[var(--accent-dark)]">More in {guide.category}</h3>
				<div class="idx-card flex flex-col">
					{related.map((g, i) => (
						<a href={`/${g.slug}/`} class="group block border-b border-dotted border-[var(--rule)] px-5 py-3 no-underline last:border-b-0">
							<span class="dir-row">
								<span class="font-mono-num shrink-0 text-[0.78rem] font-bold text-[var(--accent-dark)]">{String(i + 1).padStart(2, '0')}</span>
								<span class="min-w-0 text-[0.9375rem] font-semibold leading-snug text-[var(--ink)] group-hover:underline">{g.title}</span>
								<span class="dir-leader" aria-hidden="true"></span>
								<span class="dir-arrow font-mono-num shrink-0 text-sm text-[var(--accent-dark)]" aria-hidden="true">&rarr;</span>
							</span>
						</a>
					))}
				</div>
			</div>
		)}

		<FeedbackSlip />

		<div class="mt-10 border-t border-[var(--rule)] pt-6 text-sm text-[var(--ink)]/55">
			<p class="m-0">Written and edited by the <a href="/about/" class="text-[var(--ink)]/70 no-underline hover:text-[var(--ink)] hover:underline">{AUTHOR_NAME}</a></p>
		</div>
	</div>
</Layout>

<style>
	.adsterra-slots {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		padding: 1.5rem 0;
	}
	.adsterra-leaderboard {
		max-width: 100%;
		overflow-x: auto;
	}
</style>

