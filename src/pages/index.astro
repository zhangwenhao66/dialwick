---
import Layout from '../layouts/Layout.astro';
import { guides, type Guide, type GuideCategory } from '../data/guides';
import { getDialingGuide } from '../lib/internationalDialing';

const sorted = [...guides].sort((a, b) => b.updated.localeCompare(a.updated));

const SECTIONS: { category: GuideCategory[]; label: string; path: string; deck: string }[] = [
	{
		category: ['Area Code Lists', 'Area Code Guides', 'Area Codes'],
		label: 'Area Codes',
		path: '/area-codes/',
		deck: 'State and province lists, individual lookups, and how the numbering plan actually works.',
	},
	{
		category: ['ZIP Codes'],
		label: 'ZIP Codes',
		path: '/zip-codes/',
		deck: 'City ZIP code lists and county breakdowns, sourced from USPS/Census data.',
	},
	{
		category: ['Counties'],
		label: 'Counties',
		path: '/counties/',
		deck: 'Which county a major US city actually sits in.',
	},
	{
		category: ['International Dialing'],
		label: 'International Dialing',
		path: '/international-dialing/',
		deck: 'Current dialing formats for calling abroad from the US.',
	},
];

const bySection = SECTIONS.map((s) => ({
	...s,
	items: sorted.filter((g) => s.category.includes(g.category)).slice(0, 3),
}));

// Directory-entry code: the mono lead-in for each row. Real codes where the
// entry has one (an area code in the title, a country calling code from the
// dialing data); otherwise a padded row number, like a printed contents page.
function entryCode(g: Guide, i: number): string {
	if (g.category === 'International Dialing') {
		const dg = getDialingGuide(g.slug);
		if (dg?.countryCode) return `+${dg.countryCode}`;
	}
	if (g.category === 'Area Code Lists' || g.category === 'Area Code Guides' || g.category === 'Area Codes') {
		// Only area-code titles carry a real NANP code; ZIP titles' numbers
		// are counts ("All 311 ..."), not codes.
		const m = g.title.match(/\b[2-9]\d{2}\b/);
		if (m) return m[0];
	}
	return String(i + 1).padStart(2, '0');
}
---

<Layout>
	<!-- Directory cover strip: name plate between brass hairlines, no hero. -->
	<section class="border-y-2 border-[var(--accent)] py-7 text-center md:py-9">
		<p class="font-mono-num m-0 text-[0.68rem] font-semibold tracking-[0.22em] text-[var(--accent-dark)] uppercase">
			DialWick &middot; Number Directory
		</p>
		<h1 class="mx-auto mt-3 max-w-3xl text-3xl leading-[1.15] font-bold tracking-tight text-[var(--ink)] md:text-4xl">
			Where a phone number is really from, and why.
		</h1>
		<p class="mx-auto mt-4 mb-0 max-w-xl text-[0.95rem] leading-relaxed text-[var(--ink)]/70">
			Area codes, ZIP codes, counties, and international dialing formats -- sourced from NANPA,
			USPS/Census data, and current carrier records, with the split-and-overlay history and local
			context a one-line answer leaves out.
		</p>
	</section>

	<!-- Index cards: one tabbed card per directory section. -->
	{bySection.map((s) => (
		<section class="mt-10 first-of-type:mt-12">
			<h2 class="idx-tab m-0 text-base font-bold tracking-tight text-[var(--ink)]">{s.label}</h2>
			<div class="idx-card">
				<p class="m-0 border-b border-dotted border-[var(--rule)] px-5 py-3 text-sm text-[var(--ink)]/70">{s.deck}</p>

				{s.items.length === 0 ? (
					<p class="m-0 px-5 py-4 text-sm text-[var(--ink)]/60">Coming soon.</p>
				) : (
					<div class="flex flex-col">
						{s.items.map((g, i) => (
							<a href={`/${g.slug}/`} class="group block border-b border-dotted border-[var(--rule)] px-5 py-3.5 no-underline">
								<span class="dir-row">
									<span class="font-mono-num shrink-0 text-[0.82rem] font-bold text-[var(--accent-dark)]">{entryCode(g, i)}</span>
									<span class="min-w-0 text-[0.95rem] font-bold leading-snug text-[var(--ink)] group-hover:underline">{g.title}</span>
									<span class="dir-leader" aria-hidden="true"></span>
									<span class="dir-arrow font-mono-num shrink-0 text-sm text-[var(--accent-dark)]" aria-hidden="true">&rarr;</span>
								</span>
								<span class="mt-1 block text-sm leading-relaxed text-[var(--ink)]/70">{g.description}</span>
							</a>
						))}
					</div>
				)}

				<a href={s.path} class="group block px-5 py-3 no-underline">
					<span class="dir-row">
						<span class="font-mono-num shrink-0 text-[0.82rem] font-bold text-[var(--accent-dark)]">&sect;</span>
						<span class="text-sm font-semibold text-[var(--accent-dark)] group-hover:underline">Browse all {s.label.toLowerCase()}</span>
						<span class="dir-leader" aria-hidden="true"></span>
						<span class="dir-arrow font-mono-num shrink-0 text-sm text-[var(--accent-dark)]" aria-hidden="true">&rarr;</span>
					</span>
				</a>
			</div>
		</section>
	))}
</Layout>
